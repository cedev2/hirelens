# Copy these env vars into Render Dashboard > Environment

# Server (Render assigns PORT automatically)
PORT=5001
NODE_ENV=production
FRONTEND_URL=https://your-app.vercel.app

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/HireLens?retryWrites=true&w=majority

# JWT
JWT_SECRET=<generate-a-strong-random-string>
JWT_EXPIRES_IN=7d

# Google AI (Gemini)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.6-flash

# AI Screening performance
SCREENING_AI_CONCURRENCY=3
SCREENING_AI_RETRIES=2
SCREENING_AI_TOP_K=0

# Groq (optional)
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b

# Email (Gmail SMTP)
ENABLE_EMAILS=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM=your@gmail.com

# EjoChat AI
EJOCHAT_API_KEY=your-ejochat-key
